.pio/
.vscode/
.DS_Store

# Generated by pioarduino when it recompiles the Arduino core (custom_sdkconfig)
/.dummy/
/managed_components/
/sdkconfig.*
/dependencies.lock
/CMakeLists.txt

# Personal settings: Wi-Fi password, upload key, heart rate zones.
# Templates: src/secrets.example.h and src/user_config.example.h.
src/secrets.h
src/user_config.h

# Cloud receiver: dependencies and local dev state
cloud/node_modules/
cloud/.wrangler/
cloud/.dev.vars
cloud/.env

# Simulator output (README: Without a board)
/screens/

# Walks for the history from before the board kept one (env:backfill)
src/history_seed.h

# Local copies of cloud walk data taken before repairing it
/backups/
